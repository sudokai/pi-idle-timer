{
  "name": "pi-idle-timer",
  "version": "2.0.2",
  "type": "module",
  "description": "Status-bar idle timer for pi, omp, and prime-agent: time since the agent finished its last response",
  "keywords": [
    "pi-package",
    "omp",
    "prime-agent",
    "statusbar",
    "timer"
  ],
  "pi": {
    "extensions": [
      "./extensions/idle-timer.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/format-idle-seconds.test.ts tests/widget-color.test.ts tests/runtime-compat.test.ts"
  }
}
